# Gemini for generation AND embeddings; Ollama is not required in this mode.
# Set the key privately in .env (ignored by Git) or as an environment variable.
GEMINI_API_KEY=
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Optional local mode: set BOTH providers to ollama, CHAT_MODEL=qwen3:8b,
# EMBEDDING_MODEL=nomic-embed-text:v1.5; start Ollama and ingest again.
OLLAMA_BASE_URL=http://localhost:11434
CATALOGUE_PATH=data/source/History_2024-25.pdf
INDEX_DIR=data/index
# Changing embedding model, chunk settings, or PDF requires ingestion again.
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_K=6
MODEL_TIMEOUT=180

